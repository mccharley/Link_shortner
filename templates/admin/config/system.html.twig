<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - LinkShortener Admin</title>
    
    <!-- CSS Dependencies -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }
        
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 12px 20px;
            margin: 2px 0;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: rgba(255,255,255,0.2);
            color: white;
            transform: translateX(5px);
        }
        
        .main-content {
            background: #f8f9fa;
            min-height: 100vh;
        }
        
        .config-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        
        .nav-tabs .nav-link {
            border: none;
            color: #6c757d;
            font-weight: 500;
            border-radius: 10px 10px 0 0;
        }
        
        .nav-tabs .nav-link.active {
            background: white;
            color: #667eea;
            border-bottom: 3px solid #667eea;
        }
        
        .form-section {
            border: 1px solid #e9ecef;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            background: #f8f9fa;
        }
        
        .form-section h6 {
            color: #667eea;
            font-weight: 600;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e9ecef;
        }
        
        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid #e9ecef;
        }
        
        .setting-item:last-child {
            border-bottom: none;
        }
        
        .setting-label {
            flex: 1;
            margin-right: 20px;
        }
        
        .setting-label h6 {
            margin: 0;
            color: #333;
            font-weight: 500;
        }
        
        .setting-label p {
            margin: 0;
            color: #6c757d;
            font-size: 0.9em;
        }
        
        .setting-control {
            min-width: 200px;
        }
        
        .btn-save {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }
        
        .alert-custom {
            border: none;
            border-radius: 10px;
            padding: 15px 20px;
        }
        
        .toggle-switch {
            position: relative;
            width: 60px;
            height: 30px;
            background: #ccc;
            border-radius: 15px;
            cursor: pointer;
            transition: background 0.3s;
        }
        
        .toggle-switch.active {
            background: #667eea;
        }
        
        .toggle-switch::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            width: 24px;
            height: 24px;
            background: white;
            border-radius: 50%;
            transition: left 0.3s;
        }
        
        .toggle-switch.active::after {
            left: 33px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 px-0">
                <div class="sidebar">
                    <div class="p-4">
                        <h4 class="text-white mb-4">
                            <i class="fas fa-link me-2"></i>
                            LinkShortener
                        </h4>
                    </div>
                    
                    <nav class="nav flex-column px-3">
                        <a href="/admin/dashboard" class="nav-link">
                            <i class="fas fa-tachometer-alt me-2"></i>
                            Dashboard
                        </a>
                        
                        <a href="/admin/partners" class="nav-link">
                            <i class="fas fa-users me-2"></i>
                            Partners
                        </a>
                        
                        <a href="/admin/advertisements" class="nav-link">
                            <i class="fas fa-ad me-2"></i>
                            Advertisements
                        </a>
                        
                        <a href="/admin/analytics" class="nav-link">
                            <i class="fas fa-chart-bar me-2"></i>
                            Analytics
                        </a>
                        
                        <a href="/admin/revenue" class="nav-link">
                            <i class="fas fa-dollar-sign me-2"></i>
                            Revenue
                        </a>
                        
                        <a href="/admin/security" class="nav-link">
                            <i class="fas fa-shield-alt me-2"></i>
                            Security
                        </a>
                        
                        <a href="/admin/config" class="nav-link active">
                            <i class="fas fa-cogs me-2"></i>
                            Configuration
                        </a>
                        
                        <a href="/admin/maintenance" class="nav-link">
                            <i class="fas fa-tools me-2"></i>
                            Maintenance
                        </a>
                        
                        <hr class="my-3" style="border-color: rgba(255,255,255,0.2);">
                        
                        <a href="/admin/plans" class="nav-link">
                            <i class="fas fa-layer-group me-2"></i>
                            Subscription Plans
                        </a>
                        
                        <a href="/admin/blacklist" class="nav-link">
                            <i class="fas fa-ban me-2"></i>
                            Blacklist
                        </a>
                        
                        <a href="/admin/audit" class="nav-link">
                            <i class="fas fa-history me-2"></i>
                            Audit Log
                        </a>
                    </nav>
                </div>
            </div>
            
            <!-- Main Content -->
            <div class="col-md-10 main-content">
                <div class="p-4">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="mb-0">{{ title }}</h2>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-outline-secondary me-2" onclick="exportConfig()">
                                <i class="fas fa-download me-1"></i>
                                Export Config
                            </button>
                            <button class="btn btn-outline-warning me-2" onclick="importConfig()">
                                <i class="fas fa-upload me-1"></i>
                                Import Config
                            </button>
                            <button class="btn btn-outline-danger" onclick="resetToDefaults()">
                                <i class="fas fa-undo me-1"></i>
                                Reset to Defaults
                            </button>
                        </div>
                    </div>
                    
                    <!-- Configuration Tabs -->
                    <div class="config-section">
                        <ul class="nav nav-tabs mb-4" id="configTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">
                                    <i class="fas fa-cog me-2"></i>
                                    General
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="ads-tab" data-bs-toggle="tab" data-bs-target="#ads" type="button" role="tab">
                                    <i class="fas fa-ad me-2"></i>
                                    Advertisements
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="revenue-tab" data-bs-toggle="tab" data-bs-target="#revenue" type="button" role="tab">
                                    <i class="fas fa-dollar-sign me-2"></i>
                                    Revenue
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab">
                                    <i class="fas fa-shield-alt me-2"></i>
                                    Security
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="links-tab" data-bs-toggle="tab" data-bs-target="#links" type="button" role="tab">
                                    <i class="fas fa-link me-2"></i>
                                    Links
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="maintenance-tab" data-bs-toggle="tab" data-bs-target="#maintenance" type="button" role="tab">
                                    <i class="fas fa-tools me-2"></i>
                                    Maintenance
                                </button>
                            </li>
                        </ul>
                        
                        <form id="configForm" method="POST">
                            <div class="tab-content" id="configTabContent">
                                <!-- General Configuration -->
                                <div class="tab-pane fade show active" id="general" role="tabpanel">
                                    <div class="form-section">
                                        <h6><i class="fas fa-globe me-2"></i>System Settings</h6>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Maintenance Mode</h6>
                                                <p>Enable maintenance mode to prevent new registrations and API access</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.maintenance_mode ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'maintenance_mode')">
                                                </div>
                                                <input type="hidden" name="maintenance_mode" value="{{ config.maintenance_mode ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Short Code Length</h6>
                                                <p>Default length for generated short codes (4-12 characters)</p>
                                            </div>
                                            <div class="setting-control">
                                                <input type="number" class="form-control" name="short_code_length" 
                                                       value="{{ config.short_code_length|default(6) }}" min="4" max="12">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Default Link Expiration</h6>
                                                <p>Default expiration time for new links (0 = never expires)</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="default_expiration_days" 
                                                           value="{{ config.default_expiration_days|default(0) }}" min="0" max="365">
                                                    <span class="input-group-text">days</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Analytics Enabled</h6>
                                                <p>Enable detailed click analytics and reporting</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.enable_analytics ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'enable_analytics')">
                                                </div>
                                                <input type="hidden" name="enable_analytics" value="{{ config.enable_analytics ? '1' : '0' }}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Advertisement Configuration -->
                                <div class="tab-pane fade" id="ads" role="tabpanel">
                                    <div class="form-section">
                                        <h6><i class="fas fa-ad me-2"></i>Advertisement Settings</h6>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Default Ad Duration</h6>
                                                <p>Default display time for advertisements in seconds</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="default_ad_duration" 
                                                           value="{{ config.default_ad_duration|default(15) }}" min="5" max="30">
                                                    <span class="input-group-text">seconds</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Minimum Ad Duration</h6>
                                                <p>Minimum allowed advertisement display time</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="min_ad_duration" 
                                                           value="{{ config.min_ad_duration|default(5) }}" min="3" max="15">
                                                    <span class="input-group-text">seconds</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Maximum Ad Duration</h6>
                                                <p>Maximum allowed advertisement display time</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="max_ad_duration" 
                                                           value="{{ config.max_ad_duration|default(30) }}" min="15" max="60">
                                                    <span class="input-group-text">seconds</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Default CPM Rate</h6>
                                                <p>Default cost per thousand impressions for new advertisements</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input type="number" class="form-control" name="default_ad_cpm" 
                                                           value="{{ config.default_ad_cpm|default(2.50) }}" step="0.01" min="0.01">
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Skip Button Enabled</h6>
                                                <p>Allow users to skip advertisements after a delay</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.ad_skip_enabled ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'ad_skip_enabled')">
                                                </div>
                                                <input type="hidden" name="ad_skip_enabled" value="{{ config.ad_skip_enabled ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Skip Delay</h6>
                                                <p>Seconds before skip button becomes available</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="ad_skip_delay" 
                                                           value="{{ config.ad_skip_delay|default(5) }}" min="3" max="15">
                                                    <span class="input-group-text">seconds</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Geo-Targeting Enabled</h6>
                                                <p>Enable geographic targeting for advertisements</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.ad_geo_targeting ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'ad_geo_targeting')">
                                                </div>
                                                <input type="hidden" name="ad_geo_targeting" value="{{ config.ad_geo_targeting ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Fraud Protection</h6>
                                                <p>Enable click fraud detection and prevention</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.ad_click_fraud_protection ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'ad_click_fraud_protection')">
                                                </div>
                                                <input type="hidden" name="ad_click_fraud_protection" value="{{ config.ad_click_fraud_protection ? '1' : '0' }}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Revenue Configuration -->
                                <div class="tab-pane fade" id="revenue" role="tabpanel">
                                    <div class="form-section">
                                        <h6><i class="fas fa-dollar-sign me-2"></i>Revenue Settings</h6>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Default Revenue Share</h6>
                                                <p>Default revenue share percentage for new partners</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="default_revenue_share" 
                                                           value="{{ (config.default_revenue_share|default(0.50) * 100)|round }}" min="10" max="90">
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Minimum Payout Amount</h6>
                                                <p>Minimum amount required before partner payout</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input type="number" class="form-control" name="min_payout_amount" 
                                                           value="{{ config.min_payout_amount|default(50.00) }}" step="0.01" min="1.00">
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Payout Frequency</h6>
                                                <p>How often partner payouts are processed</p>
                                            </div>
                                            <div class="setting-control">
                                                <select class="form-select" name="payout_frequency">
                                                    <option value="weekly" {{ config.payout_frequency == 'weekly' ? 'selected' : '' }}>Weekly</option>
                                                    <option value="monthly" {{ config.payout_frequency == 'monthly' ? 'selected' : '' }}>Monthly</option>
                                                    <option value="quarterly" {{ config.payout_frequency == 'quarterly' ? 'selected' : '' }}>Quarterly</option>
                                                </select>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Payout Delay</h6>
                                                <p>Days to wait before processing payouts (for fraud prevention)</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="payout_delay_days" 
                                                           value="{{ config.payout_delay_days|default(7) }}" min="0" max="30">
                                                    <span class="input-group-text">days</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Revenue Currency</h6>
                                                <p>Default currency for revenue calculations</p>
                                            </div>
                                            <div class="setting-control">
                                                <select class="form-select" name="revenue_currency">
                                                    <option value="USD" {{ config.revenue_currency == 'USD' ? 'selected' : '' }}>USD - US Dollar</option>
                                                    <option value="EUR" {{ config.revenue_currency == 'EUR' ? 'selected' : '' }}>EUR - Euro</option>
                                                    <option value="GBP" {{ config.revenue_currency == 'GBP' ? 'selected' : '' }}>GBP - British Pound</option>
                                                    <option value="CAD" {{ config.revenue_currency == 'CAD' ? 'selected' : '' }}>CAD - Canadian Dollar</option>
                                                </select>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Fraud Detection</h6>
                                                <p>Enable revenue fraud detection and prevention</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.revenue_fraud_detection ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'revenue_fraud_detection')">
                                                </div>
                                                <input type="hidden" name="revenue_fraud_detection" value="{{ config.revenue_fraud_detection ? '1' : '0' }}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Security Configuration -->
                                <div class="tab-pane fade" id="security" role="tabpanel">
                                    <div class="form-section">
                                        <h6><i class="fas fa-shield-alt me-2"></i>Security Settings</h6>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>API Rate Limiting</h6>
                                                <p>Enable rate limiting for API requests</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.api_rate_limit_enabled ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'api_rate_limit_enabled')">
                                                </div>
                                                <input type="hidden" name="api_rate_limit_enabled" value="{{ config.api_rate_limit_enabled ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Rate Limit Requests</h6>
                                                <p>Maximum API requests per hour per partner</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="api_rate_limit_requests" 
                                                           value="{{ config.api_rate_limit_requests|default(1000) }}" min="100" max="10000">
                                                    <span class="input-group-text">per hour</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Email Verification Required</h6>
                                                <p>Require email verification for new partner registrations</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.email_verification_required ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'email_verification_required')">
                                                </div>
                                                <input type="hidden" name="email_verification_required" value="{{ config.email_verification_required ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>MFA Enforcement</h6>
                                                <p>Multi-factor authentication requirement level</p>
                                            </div>
                                            <div class="setting-control">
                                                <select class="form-select" name="mfa_enforcement">
                                                    <option value="disabled" {{ config.mfa_enforcement == 'disabled' ? 'selected' : '' }}>Disabled</option>
                                                    <option value="optional" {{ config.mfa_enforcement == 'optional' ? 'selected' : '' }}>Optional</option>
                                                    <option value="required" {{ config.mfa_enforcement == 'required' ? 'selected' : '' }}>Required</option>
                                                </select>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Maximum Login Attempts</h6>
                                                <p>Maximum failed login attempts before account lockout</p>
                                            </div>
                                            <div class="setting-control">
                                                <input type="number" class="form-control" name="max_login_attempts" 
                                                       value="{{ config.max_login_attempts|default(5) }}" min="3" max="10">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Account Lockout Duration</h6>
                                                <p>Minutes to lock account after max failed attempts</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="lockout_duration_minutes" 
                                                           value="{{ config.lockout_duration_minutes|default(30) }}" min="5" max="1440">
                                                    <span class="input-group-text">minutes</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Session Timeout</h6>
                                                <p>Automatic session timeout for inactive users</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="session_timeout_minutes" 
                                                           value="{{ config.session_timeout_minutes|default(1440) }}" min="30" max="10080">
                                                    <span class="input-group-text">minutes</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Links Configuration -->
                                <div class="tab-pane fade" id="links" role="tabpanel">
                                    <div class="form-section">
                                        <h6><i class="fas fa-link me-2"></i>Link Management</h6>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Custom Aliases Enabled</h6>
                                                <p>Allow partners to create custom short link aliases</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.custom_aliases_enabled ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'custom_aliases_enabled')">
                                                </div>
                                                <input type="hidden" name="custom_aliases_enabled" value="{{ config.custom_aliases_enabled ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Bulk Creation Enabled</h6>
                                                <p>Allow partners to create multiple links at once</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.bulk_creation_enabled ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'bulk_creation_enabled')">
                                                </div>
                                                <input type="hidden" name="bulk_creation_enabled" value="{{ config.bulk_creation_enabled ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Bulk Creation Limit</h6>
                                                <p>Maximum number of links that can be created in one bulk operation</p>
                                            </div>
                                            <div class="setting-control">
                                                <input type="number" class="form-control" name="bulk_creation_limit" 
                                                       value="{{ config.bulk_creation_limit|default(1000) }}" min="10" max="10000">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>QR Code Generation</h6>
                                                <p>Automatically generate QR codes for shortened links</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.qr_code_generation ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'qr_code_generation')">
                                                </div>
                                                <input type="hidden" name="qr_code_generation" value="{{ config.qr_code_generation ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Domain Blacklist Enabled</h6>
                                                <p>Block links to blacklisted domains</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.domain_blacklist_enabled ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'domain_blacklist_enabled')">
                                                </div>
                                                <input type="hidden" name="domain_blacklist_enabled" value="{{ config.domain_blacklist_enabled ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Link Validation</h6>
                                                <p>Validate destination URLs before creating short links</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.link_validation_enabled ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'link_validation_enabled')">
                                                </div>
                                                <input type="hidden" name="link_validation_enabled" value="{{ config.link_validation_enabled ? '1' : '0' }}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Maintenance Configuration -->
                                <div class="tab-pane fade" id="maintenance" role="tabpanel">
                                    <div class="form-section">
                                        <h6><i class="fas fa-tools me-2"></i>Maintenance Settings</h6>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Auto Cleanup Enabled</h6>
                                                <p>Automatically clean up expired links and old data</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.auto_cleanup_enabled ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'auto_cleanup_enabled')">
                                                </div>
                                                <input type="hidden" name="auto_cleanup_enabled" value="{{ config.auto_cleanup_enabled ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Analytics Retention</h6>
                                                <p>How long to keep detailed analytics data</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="analytics_retention_days" 
                                                           value="{{ config.analytics_retention_days|default(730) }}" min="30" max="3650">
                                                    <span class="input-group-text">days</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Log Retention</h6>
                                                <p>How long to keep system and error logs</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" name="log_retention_days" 
                                                           value="{{ config.log_retention_days|default(90) }}" min="7" max="365">
                                                    <span class="input-group-text">days</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Database Optimization</h6>
                                                <p>Automatically optimize database tables</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.database_optimization ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'database_optimization')">
                                                </div>
                                                <input type="hidden" name="database_optimization" value="{{ config.database_optimization ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Backup Enabled</h6>
                                                <p>Enable automatic database backups</p>
                                            </div>
                                            <div class="setting-control">
                                                <div class="toggle-switch {{ config.backup_enabled ? 'active' : '' }}" 
                                                     onclick="toggleSetting(this, 'backup_enabled')">
                                                </div>
                                                <input type="hidden" name="backup_enabled" value="{{ config.backup_enabled ? '1' : '0' }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-item">
                                            <div class="setting-label">
                                                <h6>Backup Frequency</h6>
                                                <p>How often to create database backups</p>
                                            </div>
                                            <div class="setting-control">
                                                <select class="form-select" name="backup_frequency">
                                                    <option value="hourly" {{ config.backup_frequency == 'hourly' ? 'selected' : '' }}>Hourly</option>
                                                    <option value="daily" {{ config.backup_frequency == 'daily' ? 'selected' : '' }}>Daily</option>
                                                    <option value="weekly" {{ config.backup_frequency == 'weekly' ? 'selected' : '' }}>Weekly</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Save Button -->
                            <div class="text-center mt-4">
                                <button type="submit" class="btn btn-save">
                                    <i class="fas fa-save me-2"></i>
                                    Save Configuration
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- JavaScript Dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Toggle switch functionality
        function toggleSetting(element, fieldName) {
            element.classList.toggle('active');
            const hiddenInput = document.querySelector(`input[name="${fieldName}"]`);
            hiddenInput.value = element.classList.contains('active') ? '1' : '0';
        }
        
        // Form submission
        document.getElementById('configForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);
            
            // Convert percentage values
            if (data.default_revenue_share) {
                data.default_revenue_share = parseFloat(data.default_revenue_share) / 100;
            }
            
            fetch('/admin/config/system', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    showAlert('Configuration saved successfully!', 'success');
                } else {
                    showAlert('Error saving configuration: ' + result.message, 'danger');
                }
            })
            .catch(error => {
                showAlert('Error: ' + error.message, 'danger');
            });
        });
        
        // Utility functions
        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-custom alert-dismissible fade show`;
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            const container = document.querySelector('.main-content .p-4');
            container.insertBefore(alertDiv, container.firstChild);
            
            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }
        
        function exportConfig() {
            window.open('/admin/config/export', '_blank');
        }
        
        function importConfig() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.json';
            input.onchange = function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        try {
                            const config = JSON.parse(e.target.result);
                            
                            if (confirm('This will overwrite your current configuration. Are you sure?')) {
                                fetch('/admin/config/import', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'X-Requested-With': 'XMLHttpRequest'
                                    },
                                    body: JSON.stringify(config)
                                })
                                .then(response => response.json())
                                .then(result => {
                                    if (result.success) {
                                        showAlert('Configuration imported successfully!', 'success');
                                        setTimeout(() => location.reload(), 2000);
                                    } else {
                                        showAlert('Error importing configuration: ' + result.message, 'danger');
                                    }
                                })
                                .catch(error => {
                                    showAlert('Error: ' + error.message, 'danger');
                                });
                            }
                        } catch (error) {
                            showAlert('Invalid configuration file', 'danger');
                        }
                    };
                    reader.readAsText(file);
                }
            };
            input.click();
        }
        
        function resetToDefaults() {
            if (confirm('This will reset all configuration to default values. Are you sure?')) {
                fetch('/admin/config/reset', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        showAlert('Configuration reset to defaults!', 'success');
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        showAlert('Error resetting configuration: ' + result.message, 'danger');
                    }
                })
                .catch(error => {
                    showAlert('Error: ' + error.message, 'danger');
                });
            }
        }
    </script>
</body>
</html>